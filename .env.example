# ─── Required for the interesting parts ──────────────────────────────────────
# Reads the frames: clues, region guesses and the map features to search for.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
# FF_VISION_MODEL=

# ─── Reverse image search (pick one or both) ─────────────────────────────────
# TinEye accepts uploads and reports crawl dates, so it works on localhost.
TINEYE_API_KEY=
# SerpApi gives Google Lens, Bing and Yandex. These engines fetch frames by URL,
# so frames must be publicly reachable: set PUBLIC_BASE_URL or use Supabase.
SERPAPI_KEY=
# SERPAPI_ENGINES=google_lens,bing_reverse_image,yandex_images

# Public URL of this deployment, e.g. https://firstframe.example.org
PUBLIC_BASE_URL=

# ─── Optional AI-image detectors (shown as signals, never verdicts) ──────────
HIVE_API_KEY=
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# ─── Storage: local disk by default, Supabase if both are set ────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=frames
# FF_DATA_DIR=.firstframe

# ─── Tools and services ──────────────────────────────────────────────────────
# YTDLP_PATH=yt-dlp
# Netscape cookie file for platforms that need a login (Instagram, some X posts).
# YTDLP_COOKIES=
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# C2PATOOL_PATH=c2patool
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# Raster tiles for the card's mini-map. "off" disables it. Heavy use of the
# public OSM tile server is against its policy; point this at your own tiles.
# FF_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron

# ─── Limits ──────────────────────────────────────────────────────────────────
# FF_MAX_FRAMES=8
# FF_SEARCH_FRAMES=3
# FF_MAX_DURATION=600
# FF_MAX_CONCURRENT=2
# Checks per IP per hour. 0 disables the limit.
# FF_RATE_LIMIT=20
# Reuse a report for the same link within this many hours.
# FF_CACHE_HOURS=24
